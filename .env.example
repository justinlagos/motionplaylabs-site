# Resend API key for the contact form (domain motionplaylabs.com is verified in Resend)
RESEND_API_KEY=
# Where enquiries are sent
CONTACT_TO=hello@motionplaylabs.com
# Sender address on the verified domain
CONTACT_FROM=MotionPlay Labs <hello@motionplaylabs.com>

# Festival Town waitlist (/festival-town). Supabase project "Workshop", table ft_waitlist, insert-only.
# Both have safe defaults in the route; set them here only to point at another project or key.
FT_SUPABASE_URL=https://imbhdffupsfehifcbdfb.supabase.co
FT_SUPABASE_KEY=sb_publishable_72d5o8iR-PD3jvL83XBvkA_HGy66fZA
# Sender and studio copy for waitlist emails (defaults: hello@motionplaylabs.com)
FT_FROM=Festival Town <hello@motionplaylabs.com>
FT_NOTIFY=hello@motionplaylabs.com

# Admin pages (/admin/festival-town/). Basic sign-in. With no ADMIN_PASSWORD the admin pages return 404.
ADMIN_USER=justin
ADMIN_PASSWORD=
# Server-only keys the analytics page reads with. Never prefix these with NEXT_PUBLIC_.
# Supabase "Workshop" secret key: reads ft_events (game play counts) and ft_waitlist.
FT_SUPABASE_SERVICE_KEY=
# Supabase "Festival Town" project and its secret key: reads Festival Night purchases.
FT2_SUPABASE_URL=https://kilypriuivfeftdzhhon.supabase.co
FT2_SUPABASE_SERVICE_KEY=
# Vercel Web Analytics for this project: a read token, the project id, and the team id if it sits in a team.
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
